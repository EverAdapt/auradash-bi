{
  "name": "auradash-bi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v02": "vite --port 5320",
    "check:agnostic": "bun scripts/check-agnostic.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build-catalog": "bun scripts/build-catalog.ts && bun run gen-bundled",
    "gen-bundled": "bun scripts/gen-bundled.ts",
    "events:report": "bun scripts/events.ts",
    "deploy": "vite build && wrangler deploy",
    "deploy:demo": "CLOUDFLARE_ENV=demo vite build && wrangler deploy --env demo"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.13",
    "@typesafe-ai/sdk": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "d3-geo": "^3.1.1",
    "hono": "^4.13.8",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-is": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@eslint/js": "^10",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.136.3"
  }
}
