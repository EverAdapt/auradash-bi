# OWNER: platform. Cloudflare Workers static assets honour this file. Kept in sync BY HAND with
# worker/headers.ts's SECURITY_HEADERS/CONTENT_SECURITY_POLICY, which apply the same values to
# /api/* responses (this file only reaches static assets — /api/* is run_worker_first and never
# touches the asset server).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
